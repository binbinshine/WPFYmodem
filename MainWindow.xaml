<Window x:Class="WPFYmodem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFYmodem" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="HMT070ATA-6 Ymodem文件传输工具" 
        Height="850" Width="1200"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 颜色定义（修改为SolidColorBrush） -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1ABC9C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="LightBrush" Color="#ECF0F1"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#2C3E50"/>

        <!-- 渐变色画笔 -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3498DB" Offset="0"/>
            <GradientStop Color="#2980B9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2ECC71" Offset="0"/>
            <GradientStop Color="#27AE60" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E74C3C" Offset="0"/>
            <GradientStop Color="#C0392B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1ABC9C" Offset="0"/>
            <GradientStop Color="#16A085" Offset="1"/>
        </LinearGradientBrush>

        <!-- 字体权重定义 -->
        <FontWeight x:Key="MediumWeight">Medium</FontWeight>
        <FontWeight x:Key="SemiBoldWeight">SemiBold</FontWeight>
        <FontWeight x:Key="BoldWeight">Bold</FontWeight>

        <!-- 通用样式 -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Margin" Value="4,8,4,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource DarkBrush}"/>
            <Setter Property="FontWeight" Value="{StaticResource MediumWeight}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="{StaticResource BoldWeight}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ProgressGradient}"/>
        </Style>

        <!-- 特殊按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="FontWeight" Value="{StaticResource BoldWeight}"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
            <Setter Property="FontWeight" Value="{StaticResource BoldWeight}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
            <Setter Property="FontWeight" Value="{StaticResource BoldWeight}"/>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
            <Setter Property="FontWeight" Value="{StaticResource BoldWeight}"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="FontWeight" Value="{StaticResource BoldWeight}"/>
        </Style>

        <!-- 状态指示器样式 -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- 列表项样式 -->
        <Style x:Key="FileListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                Padding="4"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--<Grid Background="#F8F9FA">-->
        <Grid Background="Red">
        <!-- 主布局 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" 
                Padding="16" CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 图标和标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="HMT070ATA-6 Ymodem文件传输工具" 
                               FontSize="18" 
                               FontWeight="{StaticResource SemiBoldWeight}"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 版本信息 -->
                <TextBlock Grid.Column="2" 
                           Text="v1.0.0" 
                           Foreground="White" 
                           Opacity="0.8"
                           VerticalAlignment="Center"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- 操作工具栏 -->
        <Border Grid.Row="1" Background="White" Margin="16,8" Padding="16" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 串口操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="串口操作" 
                               FontWeight="{StaticResource BoldWeight}" 
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="btnConnect" 
                            Content="🔗 连接串口" 
                            Width="100" 
                            Style="{StaticResource MaterialDesignFloatingActionDarkButton}"
                            Click="BtnConnect_Click"/>
                    <Button x:Name="btnDisconnect" 
                            Content="🔌 断开连接" 
                            Width="100" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnDisconnect_Click" 
                            IsEnabled="False"/>
                    <Button x:Name="btnRefreshPorts" 
                            Content="🔄 刷新串口" 
                            Width="100" 
                            Click="BtnRefreshPorts_Click"/>
                </StackPanel>

                <!-- 文件操作 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="文件操作" 
                               FontWeight="{StaticResource BoldWeight}" 
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="btnSelectFile" 
                            Content="📄 选择文件" 
                            Width="100" 
                            Click="BtnSelectFile_Click"/>
                    <Button x:Name="btnSelectFolder" 
                            Content="📁 选择文件夹" 
                            Width="100" 
                            Click="BtnSelectFolder_Click"/>
                    <Button x:Name="btnClearFiles" 
                            Content="🗑️ 清空列表" 
                            Width="100" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnClearFiles_Click"/>
                </StackPanel>

                <!-- 传输控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnStartTransfer" 
                            Content="▶ 开始传输" 
                            Width="110" 
                            Style="{StaticResource SuccessButtonStyle}"
                            Click="BtnStartTransfer_Click" 
                            IsEnabled="False"/>
                    <Button x:Name="btnCancelTransfer" 
                            Content="⏹️ 取消传输" 
                            Width="110" 
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnCancelTransfer_Click" 
                            IsEnabled="False"/>
                    <Button x:Name="btnReset" 
                            Content="🔄 复位模块" 
                            Width="100" 
                            Style="{StaticResource WarningButtonStyle}"
                            Click="BtnReset_Click" 
                            IsEnabled="False"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：串口配置面板 -->
            <GroupBox Grid.Column="0" Header="⚙️ 串口配置">
                <StackPanel>
                    <!-- 串口设置 -->
                    <StackPanel.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,4"/>
                        </Style>
                    </StackPanel.Resources>

                    <Label Content="串口端口"/>
                    <ComboBox x:Name="cbComPort" IsEditable="True"
                              PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                              MouseEnter="ComboBox_MouseEnter"
                              MouseLeave="ComboBox_MouseLeave">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔌" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label Content="波特率"/>
                    <ComboBox x:Name="cbBaudRate" SelectedIndex="3"
                              PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                              MouseEnter="ComboBox_MouseEnter"
                              MouseLeave="ComboBox_MouseLeave">
                        <ComboBoxItem>9600</ComboBoxItem>
                        <ComboBoxItem>19200</ComboBoxItem>
                        <ComboBoxItem>38400</ComboBoxItem>
                        <ComboBoxItem>115200</ComboBoxItem>
                        <ComboBoxItem>230400</ComboBoxItem>
                        <ComboBoxItem>460800</ComboBoxItem>
                        <ComboBoxItem>921600</ComboBoxItem>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <Label Content="数据位"/>
                            <ComboBox x:Name="cbDataBits" SelectedIndex="3"
                                      PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                                      MouseEnter="ComboBox_MouseEnter"
                                      MouseLeave="ComboBox_MouseLeave">
                                <ComboBoxItem>5</ComboBoxItem>
                                <ComboBoxItem>6</ComboBoxItem>
                                <ComboBoxItem>7</ComboBoxItem>
                                <ComboBoxItem>8</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <Label Content="停止位"/>
                            <ComboBox x:Name="cbStopBits" SelectedIndex="0"
                                      PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                                      MouseEnter="ComboBox_MouseEnter"
                                      MouseLeave="ComboBox_MouseLeave">
                                <ComboBoxItem>1</ComboBoxItem>
                                <ComboBoxItem>1.5</ComboBoxItem>
                                <ComboBoxItem>2</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1">
                            <Label Content="校验位"/>
                            <ComboBox x:Name="cbParity" SelectedIndex="0"
                                      PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                                      MouseEnter="ComboBox_MouseEnter"
                                      MouseLeave="ComboBox_MouseLeave">
                                <ComboBoxItem>None</ComboBoxItem>
                                <ComboBoxItem>Odd</ComboBoxItem>
                                <ComboBoxItem>Even</ComboBoxItem>
                                <ComboBoxItem>Mark</ComboBoxItem>
                                <ComboBoxItem>Space</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="1">
                            <Label Content="流控制"/>
                            <ComboBox x:Name="cbFlowControl" SelectedIndex="0"
                                      PreviewMouseWheel="ComboBox_PreviewMouseWheel"
                                      MouseEnter="ComboBox_MouseEnter"
                                      MouseLeave="ComboBox_MouseLeave">
                                <ComboBoxItem>None</ComboBoxItem>
                                <ComboBoxItem>XOnXOff</ComboBoxItem>
                                <ComboBoxItem>RequestToSend</ComboBoxItem>
                                <ComboBoxItem>RequestToSendXOnXOff</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- 选项 -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="chkAutoConnect" Content="启动时自动连接"/>
                        <CheckBox x:Name="chkAutoRefresh" Content="自动刷新串口" 
                                  IsChecked="True" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- 传输统计 -->
                    <Border Margin="0,16,0,0" 
                            Background="#F8F9FA" 
                            BorderThickness="1" 
                            BorderBrush="#E0E0E0"
                            CornerRadius="6"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="📊 传输统计" 
                                       FontWeight="{StaticResource BoldWeight}" 
                                       FontSize="14"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前文件:" 
                                           Opacity="0.8" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                           x:Name="txtCurrentFileStat" 
                                           Text="无" 
                                           FontWeight="{StaticResource MediumWeight}"
                                           Margin="8,2,0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="文件进度:" 
                                           Opacity="0.8" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                           x:Name="txtFileProgressStat" 
                                           Text="0%" 
                                           FontWeight="{StaticResource MediumWeight}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="8,2,0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="总体进度:" 
                                           Opacity="0.8" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" 
                                           x:Name="txtOverallProgressStat" 
                                           Text="0%" 
                                           FontWeight="{StaticResource MediumWeight}"
                                           Foreground="{StaticResource SecondaryBrush}"
                                           Margin="8,2,0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="已传输:" 
                                           Opacity="0.8" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" 
                                           x:Name="txtBytesTransferred" 
                                           Text="0 B" 
                                           FontWeight="{StaticResource MediumWeight}"
                                           Margin="8,2,0,2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 复位提示 -->
                    <Border x:Name="resetPromptBorder"
                            Margin="0,12,0,0" 
                            Background="#FFF3E0" 
                            BorderThickness="1" 
                            BorderBrush="#FF9800"
                            CornerRadius="6"
                            Padding="12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="模块需要复位" 
                                           FontWeight="{StaticResource BoldWeight}" 
                                           Foreground="#E65100"/>
                            </StackPanel>
                            <TextBlock Text="文件传输已完成，请点击右上角的" 
                                       TextWrapping="Wrap"
                                       FontSize="12"/>
                            <TextBlock Text="【复位模块】" 
                                       FontWeight="{StaticResource BoldWeight}" 
                                       Foreground="#E65100"
                                       FontSize="12"/>
                            <TextBlock Text="按钮重启设备。" 
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- 右侧：文件列表和日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 文件列表 -->
                <GroupBox Grid.Row="0" Header="📁 文件列表">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 文件统计 -->
                        <Border Grid.Row="0" 
                                Background="#F8F9FA" 
                                Padding="8" 
                                CornerRadius="4"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 统计: " FontWeight="{StaticResource MediumWeight}"/>
                                <TextBlock x:Name="txtTotalFiles" Text="0 个文件" 
                                           FontWeight="{StaticResource BoldWeight}" Margin="4,0,0,0"/>
                                <TextBlock Text="，总大小: " Margin="8,0,0,0"/>
                                <TextBlock x:Name="txtTotalSize" Text="0 B" 
                                           FontWeight="{StaticResource BoldWeight}"/>
                            </StackPanel>
                        </Border>

                        <!-- 文件列表 -->
                        <ListBox x:Name="lbFiles" 
                                 Grid.Row="1" 
                                 ItemsSource="{Binding FileList}"
                                 SelectionChanged="LbFiles_SelectionChanged"
                                 ItemContainerStyle="{StaticResource FileListItemStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="#F0F0F0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 文件图标和名称 -->
                                            <TextBlock Grid.Column="0" Text="📄" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding FileName}" 
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <!-- 文件大小 -->
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding FileSize, StringFormat='\{0\} B'}" 
                                                       Foreground="#666"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0"/>

                                            <!-- 进度显示 -->
                                            <Grid Grid.Column="3" 
                                                  Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Width="120"
                                                  Margin="16,0,8,0"
                                                  VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ProgressBar Height="8" 
                                                             Value="{Binding Progress}" 
                                                             Maximum="100"/>
                                            </Grid>

                                            <!-- 进度百分比 -->
                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding Progress, StringFormat='\{0\}%'}" 
                                                       FontWeight="{StaticResource BoldWeight}"
                                                       Foreground="{StaticResource SecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Margin="8,0,0,0"/>

                                            <!-- 状态标签 -->
                                            <TextBlock Grid.Column="4" 
                                                       Text="等待"
                                                       Foreground="#95A5A6"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='inverse'}"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <!--<Button
  Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"
  IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
  Style="{StaticResource MaterialDesignIconButton}"
  ToolTip="MaterialDesignIconButton">
                                <materialDesign:PackIcon
    Kind="Play" />
                            </Button>-->
                            <Button x:Name="btnMoveUp" Content="↑ 上移" Width="80" Height="32"
                                    Click="BtnMoveUp_Click" IsEnabled="False"/>
                            <Button x:Name="btnMoveDown" Content="↓ 下移" Width="80" Height="32"
                                    Click="BtnMoveDown_Click" IsEnabled="False"/>
                            <Button x:Name="btnRemoveSelected" Content="移除选中" Width="80" Height="32"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnRemoveSelected_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 分割线 -->
                <GridSplitter Grid.Row="1" Height="2" VerticalAlignment="Stretch" Background="#E0E0E0"/>

                <!-- 日志区域 -->
                <GroupBox Grid.Row="2" Header="📝 通信日志">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 日志文本框 -->
                        <RichTextBox x:Name="rtbLog" 
                                     Grid.Row="0"
                                     IsReadOnly="True" 
                                     VerticalScrollBarVisibility="Auto"
                                     Background="White"
                                     BorderThickness="0"
                                     Padding="4">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>

                        <!-- 进度条和操作按钮 -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 进度条 -->
                            <Border Grid.Column="0" 
                                    Background="#F8F9FA" 
                                    Padding="8" 
                                    CornerRadius="4"
                                    Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 进度条 -->
                                        <ProgressBar x:Name="progressBar" 
                                                     Grid.Row="0"
                                                     Height="12"/>

                                        <!-- 进度信息 -->
                                        <StackPanel Grid.Row="1" 
                                                    Orientation="Horizontal" 
                                                    HorizontalAlignment="Center"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="当前: "/>
                                            <TextBlock x:Name="txtCurrentFile" FontWeight="{StaticResource MediumWeight}"/>
                                            <TextBlock Text=" ("/>
                                            <TextBlock x:Name="txtFileProgress" FontWeight="{StaticResource MediumWeight}"/>
                                            <TextBlock Text=") | "/>
                                            <TextBlock Text="已传输: "/>
                                            <TextBlock x:Name="txtTransferredSize" FontWeight="{StaticResource MediumWeight}"/>
                                            <TextBlock Text=" | "/>
                                            <TextBlock Text="总体: "/>
                                            <TextBlock x:Name="txtOverallProgress" FontWeight="{StaticResource MediumWeight}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 日志操作按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnTestYmodem" 
                                        Content="🧪 测试Ymodem" 
                                        Width="100" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnTestYmodem_Click" 
                                        IsEnabled="False"/>
                                <Button x:Name="btnClearLog" 
                                        Content="清空日志" 
                                        Width="80" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnClearLog_Click"/>
                                <Button x:Name="btnSaveLog" 
                                        Content="💾 保存日志" 
                                        Width="80" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnSaveLog_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="indicatorConnection" 
                             Style="{StaticResource StatusIndicatorStyle}"
                             Fill="Gray"/>
                    <TextBlock x:Name="txtConnectionStatus" Text="未连接"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="indicatorTransfer" 
                             Style="{StaticResource StatusIndicatorStyle}"
                             Fill="Gray"/>
                    <TextBlock x:Name="txtTransferStatus" Text="空闲"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="文件: " Opacity="0.8"/>
                    <TextBlock x:Name="txtFileCount" Text="0" FontWeight="{StaticResource BoldWeight}" Margin="2,0,0,0"/>
                </StackPanel>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="就绪"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🕒 " Margin="0,0,4,0"/>
                    <TextBlock x:Name="txtCurrentTime" Text="--:--:--"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>